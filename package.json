{
  "name": "aro",
  "private": true,
  "version": "2.4.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bun --no-env-file --bun next dev --webpack",
    "build": "bun --no-env-file scripts/build.mjs",
    "start": "bun --no-env-file --bun next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down -v",
    "seed": "bun scripts/seed.ts",
    "hash-password": "bun scripts/hash-password.mjs --env",
    "setup-token": "bun --no-env-file scripts/setup-token.mjs",
    "setup-env": "bun --no-env-file scripts/setup-env.mjs",
    "database-url": "bun scripts/build-database-url.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@lezer/highlight": "1.2.4",
    "@typesafe-ai/sdk": "^0.6.0",
    "@uiw/react-codemirror": "^4.25.12",
    "argon2": "^0.43.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fflate": "0.8.3",
    "lucide-react": "^1.48.0",
    "mdast-util-from-markdown": "^2.0.3",
    "next": "^16.3.8",
    "node-html-parser": "9.0.4",
    "pg": "^8.16.3",
    "pretendard": "^1.3.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-force-graph-2d": "^1.29.1",
    "react-force-graph-3d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "swr": "^2.5.1",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-language-server": "^6.0.1"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "argon2",
    "unrs-resolver"
  ]
}
