# Local development template: copy to .env.local for `bun run dev`.
# Never commit real values.
# This is NOT the Docker deployment env file: the Docker Compose .env is a
# separate file generated by `bun run setup-env` (which never overwrites an
# existing one). Installation, proxy topology and recovery: docs/SETUP.md.

# Docker Compose application image (version-pinned default).
# Set this to a locally built image for source installations.
# ARO_IMAGE=ghcr.io/madrobotnet/aro:2.4.0

# Postgres app connection string (percent-encode password specials: bun run database-url)
DATABASE_URL=postgres://aro:aro@127.0.0.1:55432/aro

# Generate this dotenv-safe assignment with: bun run hash-password
# Copy the complete double-quoted AUTH_PASSWORD_HASH="..." assignment.
# Keep every printed \$ escape. The same assignment works in Next, Bun and Compose.
# Don't add escapes or double the dollar signs. Compose config may show $$
# when writing literal dollars for reuse; see docs/SETUP.md.
AUTH_PASSWORD_HASH=

# Optional: session lifetime in days (default 30)
# SESSION_TTL_DAYS=30

# Attachment storage directory (default .data/attachments)
# ATTACHMENTS_DIR=

# TypeSafe Jev (optional). Enables tag / class suggestions on inbox items.
# Capture, notes, search and graph do not require it.
# These env keys are a fallback used only while no AI settings have been saved
# in the app UI; a saved configuration (including an explicit opt-out) wins.
TYPESAFE_API_KEY=
# TYPESAFE_JEV_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# (the legacy SDK honors this endpoint; the UI can retain keys only for
# https://api.typesafe.ai or https://openrouter.ai/api;
# Jev models: typesafe jev-latest / jev-1.13.0, OpenRouter ~typesafe/jev-latest
# OpenRouter's "Jev Router" is a different product.)

# Chat model via Codex ChatGPT auth ($CODEX_HOME/auth.json or ~/.codex/auth.json). Optional.
# Like the Jev keys above, this ambient login is ignored once chat AI settings
# are saved in the UI. File readiness does not prove account validity; that is
# checked at the first real request.
# CODEX_HOME=
# CODEX_MODEL=gpt-6.1-sol
# CODEX_CHATGPT_BASE_URL=https://chatgpt.com/backend-api/codex
# Gemini CLI credential home (Docker sets /app/.data/auth/google); unset locally
# means Google CLI login is not available to the app.
# GEMINI_CLI_HOME=

# Proxy hops to trust for client IP (number of proxies appending X-Forwarded-For
# between visitor and app; 1 = single direct reverse proxy). Behind Cloudflare
# plus your own proxy the real visitor IP is 2 hops back, so the default is not
# the visitor IP there. See docs/SETUP.md.
# TRUSTED_PROXY_HOPS=1

# Optional private learned-search endpoint; empty keeps model-free search.
# Docker uses the separately generated .env. See docs/SEMANTIC-SEARCH.md.
EMBEDDING_BASE_URL=
